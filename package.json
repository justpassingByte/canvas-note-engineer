{
  "name": "canvas-note-engineer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Interactive Engineering Knowledge Graph & Canvas Notebook Plugin for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/justpassingByte/canvas-note-engineer.git"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:backend": "npm run --prefix backend dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run --prefix frontend build",
    "build:backend": "npm run --prefix backend build",
    "start": "npm run --prefix backend start",
    "test": "vitest run",
    "test:unit": "vitest run frontend/src/utils/__tests__",
    "test:integration": "vitest run backend/src/__tests__",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "vitest": "^5.0.0"
  }
}
