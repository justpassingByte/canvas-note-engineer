# ===================================================================
# CANVAS NOTE ENGINEER — AI PROVIDER CONFIGURATION (.env)
# ===================================================================
# File này chứa các biến môi trường cấu hình AI Providers (đã được .gitignore bảo vệ).
# Hỗ trợ đầy đủ Custom Provider (Ollama, vLLM, LMStudio, Local LLM, Corporate Proxy...)
# Bạn có thể cấu hình trực tiếp tại đây hoặc thông qua giao diện UI (sẽ tự động ghi vào .env).

# -------------------------------------------------------------------
# 1. CUSTOM PROVIDER & LOCAL LLM (Tùy biến 100% Base URL & Model)
# -------------------------------------------------------------------
# Ví dụ: Ollama chạy local: http://localhost:11434/v1
# Ví dụ: vLLM hoặc LMStudio: http://localhost:8000/v1
# Ví dụ: Corporate Reverse Proxy: https://llm-gateway.company.internal/v1
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.2

# -------------------------------------------------------------------
# 2. GENERIC AI FALLBACK (Áp dụng chung nếu không có cấu hình riêng)
# -------------------------------------------------------------------
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# -------------------------------------------------------------------
# 3. DEEPSEEK AI (Khuyên dùng)
# -------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# -------------------------------------------------------------------
# 4. OPENAI (GPT-4o, GPT-4o-mini, o1, o3)
# -------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -------------------------------------------------------------------
# 5. GROQ (Suy luận siêu tốc)
# -------------------------------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------------------
# 6. OPENROUTER (Gateway tổng hợp hàng trăm model)
# -------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# -------------------------------------------------------------------
# 7. ANTHROPIC CLAUDE
# -------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------------
# 8. GOOGLE GEMINI
# -------------------------------------------------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cổng khởi chạy máy chủ backend (Mặc định: 3001)
PORT=3001
